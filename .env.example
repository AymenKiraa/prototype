# Copy to .env for local development.

# --- Database -----------------------------------------------------------
# app_user role: no BYPASSRLS. Used by every tenant-facing code path via
# the tenant-scoped Prisma client factory (src/lib/db/tenant-client.ts).
DATABASE_URL="postgresql://app_user:app_user_password@localhost:5432/pitchbook?schema=public"

# platform_service role: BYPASSRLS (see prisma/manual-sql/rls.sql). Used
# ONLY by Super Admin code paths and by tenant-resolution in middleware.
DATABASE_URL_PLATFORM="postgresql://platform_service:platform_service_password@localhost:5432/pitchbook?schema=public"

# --- Auth.js secrets ------------------------------------------------------
# Three independent instances (docs/01-architecture.md §4) — three
# independent secrets, so a leaked one can't forge sessions for the others.
# Generate with: openssl rand -base64 32
AUTH_SECRET_PLATFORM_ADMIN="replace-me"
AUTH_SECRET_STAFF="replace-me"
AUTH_SECRET_CUSTOMER="replace-me"

# --- Tenant resolution (src/middleware.ts) -------------------------------
ROOT_DOMAIN="pitchbook.com"
PLATFORM_ADMIN_HOST="admin.pitchbook.com"
