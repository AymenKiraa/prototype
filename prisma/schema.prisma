// =========================================================================
// PitchBook — Multi-Tenant Football Pitch Reservation SaaS
// Phase 2: Database Schema
//
// Conventions:
//  - Every tenant-scoped model has a required `tenantId` + relation to Tenant.
//  - Every tenant-scoped model is covered by an RLS policy (see rls.sql).
//  - Money is stored as Int (minor units, e.g. cents/millimes) to avoid
//    float rounding errors. Divide by currency.minorUnit for display.
//  - Timestamps are stored in UTC (`@db.Timestamptz`); tenant timezone is
//    applied only at render time.
// =========================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist, pgcrypto]
}

// -------------------------------------------------------------------------
// PLATFORM LEVEL (not tenant-scoped)
// -------------------------------------------------------------------------

model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  systemAuditLogs SystemAuditLog[]

  @@map("platform_admins")
}

/// Append-only. Every Super Admin action against any tenant.
model SystemAuditLog {
  id              String        @id @default(uuid())
  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  tenantId        String? // nullable: some actions are platform-wide (e.g. plan edited)
  action          String // e.g. "tenant.suspend", "tenant.impersonate", "plan.update"
  targetType      String? // e.g. "Tenant", "Plan"
  targetId        String?
  metadata        Json? // old/new values, reason, etc.
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now()) @db.Timestamptz

  @@index([tenantId])
  @@index([platformAdminId])
  @@map("system_audit_logs")
}

/// Subscription plan templates, managed by Super Admin. NOT tenant-scoped.
model Plan {
  id            String   @id @default(uuid())
  key           String   @unique // "starter" | "professional" | "enterprise"
  name          String
  priceMonthly  Int // minor units
  priceYearly   Int
  currency      String   @default("USD")
  maxPitches    Int? // null = unlimited
  maxLocations  Int      @default(1)
  maxStaff      Int?
  features      Json // canonical feature set, e.g. {"analytics":true,"whiteLabel":false,...}
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  subscriptions Subscription[]

  @@map("plans")
}

// -------------------------------------------------------------------------
// TENANT
// -------------------------------------------------------------------------

enum TenantStatus {
  trial
  active
  suspended
  cancelled
}

model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique // "elite-football" -> elite-football.pitchbook.com
  status    TenantStatus @default(trial)
  ownerName String
  ownerEmail String
  phone     String?
  country   String?
  city      String?
  createdAt DateTime     @default(now()) @db.Timestamptz
  updatedAt DateTime     @updatedAt @db.Timestamptz

  settings      TenantSettings?
  branding      TenantBranding?
  domains       Domain[]
  subscriptions Subscription[]
  locations     Location[]
  pitches       Pitch[]
  users         User[]
  customers     Customer[]
  bookings      Booking[]
  pricingRules  PricingRule[]
  openingHours  OpeningHours[]
  promotions    Promotion[]
  notifTemplates NotificationTemplate[]
  notifications Notification[]
  invoices      Invoice[]
  payments      Payment[]
  auditLogs     BookingAuditLog[]

  @@map("tenants")
}

/// Custom domain mapping, resolved before subdomain fallback.
model Domain {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostname  String   @unique // "book.footballarena.tn"
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([tenantId])
  @@map("domains")
}

/// Operational configuration — booking rules, locale, currency, timezone.
model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Localization
  defaultLanguage String @default("en") // "ar" | "fr" | "en"
  timezone        String @default("UTC") // IANA tz, e.g. "Africa/Tunis"
  currency        String @default("USD") // ISO 4217
  currencySymbol  String @default("$")

  // Booking rules
  bookingWindowDays   Int @default(30) // how far ahead customers can book
  minBookingMinutes   Int @default(60)
  maxBookingMinutes   Int @default(120)
  bufferMinutes       Int @default(0) // gap enforced between bookings on same pitch
  cancellationHours   Int @default(2) // free cancellation cutoff before match
  requireAdvancePayment Boolean @default(false)
  requireConfirmation   Boolean @default(false) // manual staff confirmation before booking is final

  // Feature overrides — sparse map layered on top of plan.features
  featureOverrides Json?

  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("tenant_settings")
}

/// Visual identity, kept separate from operational settings for clean
/// "branding preview" reads/writes (Phase 8) without touching booking rules.
model TenantBranding {
  id          String @id @default(uuid())
  tenantId    String @unique
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  businessName String
  description  String?
  logoUrl      String?
  faviconUrl   String?
  coverImageUrl String?
  primaryColor   String @default("#16A34A")
  secondaryColor String @default("#111827")
  buttonStyle    String @default("rounded") // "rounded" | "square" | "pill"

  address     String?
  mapUrl      String?
  website     String?
  socialLinks Json? // {instagram, facebook, tiktok, ...}

  // Draft fields let admin preview changes before publish (requirement #3)
  draftData   Json?
  isPublished Boolean @default(true)

  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("tenant_branding")
}

// -------------------------------------------------------------------------
// SUBSCRIPTION
// -------------------------------------------------------------------------

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired
}

enum BillingCycle {
  monthly
  yearly
}

model Subscription {
  id        String             @id @default(uuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(trialing)
  billingCycle BillingCycle    @default(monthly)

  trialEndsAt      DateTime? @db.Timestamptz
  currentPeriodEnd DateTime? @db.Timestamptz
  gracePeriodEnds  DateTime? @db.Timestamptz
  cancelledAt      DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  invoices Invoice[]

  @@index([tenantId])
  @@map("subscriptions")
}

model Invoice {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  amount         Int
  currency       String
  status         String   @default("pending") // pending | paid | failed | void
  issuedAt       DateTime @default(now()) @db.Timestamptz
  paidAt         DateTime? @db.Timestamptz

  @@index([tenantId])
  @@map("invoices")
}

// -------------------------------------------------------------------------
// USERS, ROLES, PERMISSIONS (tenant staff)
// -------------------------------------------------------------------------

enum StaffRole {
  owner
  manager
  receptionist
  viewer
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  fullName     String
  role         StaffRole @default(receptionist)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  auditLogs BookingAuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// -------------------------------------------------------------------------
// LOCATIONS & PITCHES
// -------------------------------------------------------------------------

model Location {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String // "Tunis", "Ariana", "La Marsa"
  address String?
  city    String?
  timezone String? // overrides tenant default if set

  isActive Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz

  pitches      Pitch[]
  openingHours OpeningHours[]

  @@index([tenantId])
  @@map("locations")
}

model Pitch {
  id         String  @id @default(uuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  name        String
  description String?
  pitchType   String? // "5v5" | "7v7" | "11v11" etc — free text, tenant-defined
  capacity    Int?
  dimensions  String? // "40m x 20m"
  isIndoor    Boolean @default(false)
  surfaceType String? // "artificial" | "natural"
  hasLighting Boolean @default(false)
  facilities  Json? // ["parking","showers","cafeteria"]
  photos      Json? // [url, url, ...]
  basePrice   Int // minor units, fallback price
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  bookings     Booking[]
  pricingRules PricingRule[]
  blockedSlots BlockedSlot[]
  openingHours OpeningHours[]

  @@index([tenantId])
  @@index([locationId])
  @@map("pitches")
}

/// Per-pitch (or per-location, pitchId null) weekly opening hours.
model OpeningHours {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  pitchId    String?
  pitch      Pitch?    @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0=Sunday .. 6=Saturday
  opensAt   String // "08:00"
  closesAt  String // "23:00"
  isClosed  Boolean @default(false)

  @@index([tenantId])
  @@map("opening_hours")
}

/// Manual staff-created blackout slots (maintenance, private events, etc.)
model BlockedSlot {
  id        String   @id @default(uuid())
  tenantId  String
  pitchId   String
  pitch     Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  startTime DateTime @db.Timestamptz
  endTime   DateTime @db.Timestamptz
  reason    String?
  createdBy String? // userId
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([tenantId])
  @@index([pitchId, startTime, endTime])
  @@map("blocked_slots")
}

// -------------------------------------------------------------------------
// PRICING ENGINE
// -------------------------------------------------------------------------

enum PricingRuleType {
  day_based
  time_based
  special_date
  promotion
}

/// Priority resolved at booking time: special_date > time_based > day_based > Pitch.basePrice
model PricingRule {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pitchId  String? // null = applies to all tenant pitches unless overridden
  pitch    Pitch?  @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  ruleType PricingRuleType
  name     String? // "Ramadan pricing", "Weekend rate"

  daysOfWeek Json?    // [5,6] for Fri/Sat, used when ruleType = day_based
  startTime  String?  // "17:00", used when ruleType = time_based
  endTime    String?  // "23:00"
  startDate  DateTime? @db.Date // used when ruleType = special_date
  endDate    DateTime? @db.Date

  price    Int // minor units
  priority Int @default(0) // higher wins on overlap within same ruleType tier

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([tenantId])
  @@index([pitchId])
  @@map("pricing_rules")
}

model Promotion {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code            String
  discountType    String // "percentage" | "fixed"
  discountValue   Int
  validFrom       DateTime @db.Timestamptz
  validUntil      DateTime @db.Timestamptz
  maxRedemptions  Int?
  timesRedeemed   Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz

  @@unique([tenantId, code])
  @@map("promotions")
}

// -------------------------------------------------------------------------
// CUSTOMERS
// -------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName  String
  email     String?
  phone     String
  // Nullable: most customers are created as a side effect of a staff- or
  // guest-booked reservation and never set a password. Set only if/when
  // the customer opts into an account (Phase 5) to check booking history.
  passwordHash String?
  language  String?  // preferred language for notifications
  notes     String? // staff-visible notes
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  bookings Booking[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("customers")
}

// -------------------------------------------------------------------------
// BOOKINGS — the core transactional entity
// -------------------------------------------------------------------------

enum BookingStatus {
  pending // awaiting confirmation (requireConfirmation = true) or payment
  confirmed
  cancelled
  completed
  no_show
}

model Booking {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pitchId        String
  pitch          Pitch         @relation(fields: [pitchId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])

  bookingCode String @unique // "FT-TUN-20260822-8F42" — human-facing, tenant-prefixed

  startTime DateTime      @db.Timestamptz
  endTime   DateTime      @db.Timestamptz
  status    BookingStatus @default(pending)

  // Price is SNAPSHOTTED at creation — never recomputed from pricing_rules later.
  priceAmount Int
  currency    String

  notes        String?
  cancelReason String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  auditLogs BookingAuditLog[]
  payments  Payment[]

  @@index([tenantId])
  @@index([pitchId, startTime, endTime])
  @@index([customerId])
  @@map("bookings")
  // NOTE: the exclusion constraint preventing overlapping bookings per pitch
  // is added via raw SQL migration (Prisma cannot express EXCLUDE USING gist
  // natively) — see prisma/migrations/.../booking_conflict_constraint.sql
}

/// Append-only audit trail per requirement #16.
model BookingAuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  action    String // "created" | "time_changed" | "confirmed" | "cancelled" | "price_changed" | ...
  actorType String // "customer" | "staff" | "system"
  actorId   String? // userId or customerId, nullable for system actions
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([tenantId])
  @@index([bookingId])
  @@map("booking_audit_logs")
}

// -------------------------------------------------------------------------
// PAYMENTS (architecture only — no live processing in MVP)
// -------------------------------------------------------------------------

model Payment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  provider  String // "stripe" | "flouci" | "manual" | ...
  amount    Int
  currency  String
  status    String // "pending" | "succeeded" | "failed" | "refunded"
  providerRef String? // external transaction id
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([tenantId])
  @@map("payments")
}

// -------------------------------------------------------------------------
// NOTIFICATIONS
// -------------------------------------------------------------------------

model NotificationTemplate {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  eventKey String // "booking_confirmed" | "booking_cancelled" | "booking_reminder" | ...
  channel  String // "email" | "sms" | "whatsapp" | "push"
  language String @default("en")
  subject  String?
  body     String // supports {{customerName}}, {{pitchName}}, {{startTime}}, etc.

  isActive Boolean @default(true)

  @@unique([tenantId, eventKey, channel, language])
  @@map("notification_templates")
}

model Notification {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  recipientType String // "customer" | "staff"
  recipientId   String?
  channel       String
  eventKey      String
  status        String   @default("pending") // pending | sent | failed
  payload       Json?
  sentAt        DateTime? @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz

  @@index([tenantId])
  @@map("notifications")
}

// -------------------------------------------------------------------------
// DEMO TENANTS (requirement #29)
// -------------------------------------------------------------------------
// Demo tenants are ordinary Tenant rows with status distinguishing them:
// a boolean is deliberately NOT added to Tenant to avoid special-casing the
// core model. Instead a naming convention (`slug` prefixed "demo-") plus a
// scheduled cleanup job purges demo tenants after N days of inactivity.
// This keeps "demo" a lifecycle concern, not a schema concern.
